+static struct
+{
+	bool bResolved = false;
+	bool bPinned = false;
+	int nMaxDBV = 0;
+	int nIntentDBV = 0;
+	int nPinnedFloorDBV = 0;
+	char szBrightness[600];
+} s_SoftwareDim;
+
+static int software_dimming_read_int( const char *path )
+{
+	int v = -1;
+	if ( FILE *f = fopen( path, "r" ) )
+	{
+		if ( fscanf( f, "%d", &v ) != 1 )
+			v = -1;
+		fclose( f );
+	}
+	return v;
+}
+
+static bool software_dimming_write_int( const char *path, int value )
+{
+	int fd = open( path, O_WRONLY | O_CLOEXEC );
+	if ( fd < 0 )
+		return false;
+	char szBuf[16];
+	int n = snprintf( szBuf, sizeof(szBuf), "%d", value );
+	bool bOk = write( fd, szBuf, n ) == n;
+	close( fd );
+	return bOk;
+}
+
+static bool software_dimming_resolve()
+{
+	if ( s_SoftwareDim.bResolved )
+		return true;
+
+	char szDir[512] = "";
+	const char *pszName = getenv( "GAMESCOPE_SOFTWARE_DIMMING_BACKLIGHT" );
+	if ( pszName && *pszName )
+	{
+		snprintf( szDir, sizeof(szDir), "/sys/class/backlight/%s", pszName );
+	}
+	else if ( DIR *dir = opendir( "/sys/class/backlight" ) )
+	{
+		while ( struct dirent *ent = readdir( dir ) )
+		{
+			if ( ent->d_name[0] == '.' )
+				continue;
+			snprintf( szDir, sizeof(szDir), "/sys/class/backlight/%s", ent->d_name );
+			break;
+		}
+		closedir( dir );
+	}
+	if ( !szDir[0] )
+		return false;
+
+	char szMax[600];
+	snprintf( szMax, sizeof(szMax), "%s/max_brightness", szDir );
+	snprintf( s_SoftwareDim.szBrightness, sizeof(s_SoftwareDim.szBrightness), "%s/brightness", szDir );
+	s_SoftwareDim.nMaxDBV = software_dimming_read_int( szMax );
+	if ( s_SoftwareDim.nMaxDBV <= 0 )
+		return false;
+	s_SoftwareDim.bResolved = true;
+	return true;
+}
+
+static void software_dimming_update()
+{
+	static uint64_t ulLastPoll = 0;
+	uint64_t now = get_time_in_nanos();
+	if ( now - ulLastPoll < 8'000'000ul )
+		return;
+	ulLastPoll = now;
+
+	int nFloor = g_nSoftwareDimmingFloorDBV;
+	float flFactor = 1.0f;
+
+	if ( nFloor >= 2 && software_dimming_resolve() )
+	{
+		nFloor = std::min( nFloor, s_SoftwareDim.nMaxDBV );
+		int nValue = software_dimming_read_int( s_SoftwareDim.szBrightness );
+		if ( nValue >= 0 )
+		{
+			gamescope::SoftwareDimDecision d = gamescope::SoftwareDimDecide(
+				nValue, nFloor, s_SoftwareDim.bPinned, s_SoftwareDim.nPinnedFloorDBV, s_SoftwareDim.nIntentDBV );
+			s_SoftwareDim.nIntentDBV = d.nIntentDBV;
+
+			if ( d.bWantPin )
+			{
+				bool bNeedWrite = nValue != gamescope::SoftwareDimPinDBV( nFloor );
+				if ( !bNeedWrite || software_dimming_write_int( s_SoftwareDim.szBrightness, gamescope::SoftwareDimPinDBV( nFloor ) ) )
+				{
+					s_SoftwareDim.bPinned = true;
+					s_SoftwareDim.nPinnedFloorDBV = nFloor;
+					flFactor = gamescope::SoftwareDimFactor( s_SoftwareDim.nIntentDBV, nFloor, s_SoftwareDim.nMaxDBV );
+				}
+				else if ( gamescope::SoftwareDimOldPinEcho( s_SoftwareDim.bPinned, nValue, s_SoftwareDim.nPinnedFloorDBV ) )
+				{
+					flFactor = gamescope::SoftwareDimFactor( s_SoftwareDim.nIntentDBV, s_SoftwareDim.nPinnedFloorDBV, s_SoftwareDim.nMaxDBV );
+				}
+				else
+				{
+					s_SoftwareDim.bPinned = false;
+				}
+			}
+			else if ( d.bUnpin )
+			{
+				if ( !d.bWriteIntent || software_dimming_write_int( s_SoftwareDim.szBrightness, s_SoftwareDim.nIntentDBV ) )
+					s_SoftwareDim.bPinned = false;
+			}
+		}
+	}
+	else if ( s_SoftwareDim.bPinned )
+	{
+		if ( software_dimming_write_int( s_SoftwareDim.szBrightness, s_SoftwareDim.nIntentDBV ) )
+			s_SoftwareDim.bPinned = false;
+	}
+
+	g_bSoftwareDimmingCompositeForce = flFactor != 1.0f;
+	if ( g_ColorMgmt.pending.flSoftwareDimFactor != flFactor )
+	{
+		g_ColorMgmt.pending.flSoftwareDimFactor = flFactor;
+		hasRepaint = true;
+	}
+}
