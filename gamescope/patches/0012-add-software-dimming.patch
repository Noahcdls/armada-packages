diff --git a/src/SoftwareDimming.h b/src/SoftwareDimming.h
new file mode 100644
index 0000000..465a15f
--- /dev/null
+++ b/src/SoftwareDimming.h
@@ -0,0 +1,63 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+namespace gamescope
+{
+    // Pin one step below the floor so a genuine floor-value write from the
+    // client stays distinguishable from the pin echo.
+    constexpr int SoftwareDimPinDBV( int nFloorDBV )
+    {
+        return nFloorDBV - 1;
+    }
+
+    constexpr bool SoftwareDimIsNewIntent( int nValueDBV, int nFloorDBV )
+    {
+        return nValueDBV != SoftwareDimPinDBV( nFloorDBV );
+    }
+
+    // Proves the panel still shows the old pin, not merely that a pin existed.
+    constexpr bool SoftwareDimOldPinEcho( bool bPinned, int nValueDBV, int nPinnedFloorDBV )
+    {
+        return bPinned && nValueDBV == SoftwareDimPinDBV( nPinnedFloorDBV );
+    }
+
+    struct SoftwareDimDecision
+    {
+        int nIntentDBV;
+        bool bWantPin;
+        bool bWriteIntent;
+        bool bUnpin;
+    };
+
+    // Echo detection keys on the floor that performed the active pin, so a
+    // floor change cannot turn the old pin value into a stored intent.
+    constexpr SoftwareDimDecision SoftwareDimDecide(
+        int nValueDBV,
+        int nFloorDBV,
+        bool bPinned,
+        int nPinnedFloorDBV,
+        int nIntentDBV )
+    {
+        int nEchoFloor = bPinned ? nPinnedFloorDBV : nFloorDBV;
+        if ( SoftwareDimIsNewIntent( nValueDBV, nEchoFloor ) )
+            nIntentDBV = nValueDBV;
+
+        if ( nIntentDBV < nFloorDBV )
+            return { nIntentDBV, true, false, false };
+
+        return { nIntentDBV, false, bPinned && nValueDBV != nIntentDBV, bPinned };
+    }
+
+    // Panel luminance tracks roughly (dbv/max)^2.2; the factor reproduces the
+    // requested level from the floor's, held above the darkest usable output.
+    inline float SoftwareDimFactor( int nIntentDBV, int nFloorDBV, int nMaxDBV )
+    {
+        if ( nMaxDBV <= 0 || nFloorDBV < 2 || nIntentDBV >= nFloorDBV )
+            return 1.0f;
+        float flTarget = std::max( std::pow( float( std::max( nIntentDBV, 0 ) ) / float( nMaxDBV ), 2.2f ), 0.005f );
+        float flFloorLum = std::pow( float( std::min( nFloorDBV, nMaxDBV ) ) / float( nMaxDBV ), 2.2f );
+        return std::clamp( flTarget / flFloorLum, 0.0f, 1.0f );
+    }
+}
