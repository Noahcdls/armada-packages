+
+TEST_CASE("Software dim factor engages below the floor only", "[color]")
+{
+    REQUIRE( SoftwareDimFactor( 4096, 4096, 4096 ) == 1.0f );
+    REQUIRE( SoftwareDimFactor( 40, 4096, 4096 ) == 0.005f );
+    REQUIRE( SoftwareDimFactor( 0, 4096, 4096 ) == 0.005f );
+    REQUIRE( SoftwareDimFactor( 2048, 4096, 4096 ) > SoftwareDimFactor( 1024, 4096, 4096 ) );
+
+    REQUIRE( SoftwareDimFactor( 512, 1024, 4096 ) < 0.25f );
+    REQUIRE( SoftwareDimFactor( 512, 1024, 4096 ) > 0.20f );
+    REQUIRE( SoftwareDimFactor( 1022, 1024, 4096 ) > 0.99f );
+    REQUIRE( SoftwareDimFactor( 1024, 1024, 4096 ) == 1.0f );
+
+    REQUIRE( SoftwareDimFactor( 1024, 0, 4096 ) == 1.0f );
+    REQUIRE( SoftwareDimFactor( 1024, 1, 4096 ) == 1.0f );
+    REQUIRE( SoftwareDimFactor( 512, 1024, 0 ) == 1.0f );
+
+    REQUIRE( SoftwareDimIsNewIntent( 1024, 1024 ) );
+    REQUIRE( SoftwareDimIsNewIntent( 40, 1024 ) );
+    REQUIRE_FALSE( SoftwareDimIsNewIntent( 1023, 1024 ) );
+}
+
+TEST_CASE("Software dim transitions survive floor changes while pinned", "[color]")
+{
+    auto d = SoftwareDimDecide( 1023, 2048, true, 1024, 40 );
+    REQUIRE( d.nIntentDBV == 40 );
+    REQUIRE( d.bWantPin );
+
+    d = SoftwareDimDecide( 1023, 512, true, 1024, 700 );
+    REQUIRE( d.nIntentDBV == 700 );
+    REQUIRE_FALSE( d.bWantPin );
+    REQUIRE( d.bUnpin );
+    REQUIRE( d.bWriteIntent );
+
+    d = SoftwareDimDecide( 1023, 512, true, 1024, 40 );
+    REQUIRE( d.nIntentDBV == 40 );
+    REQUIRE( d.bWantPin );
+
+    d = SoftwareDimDecide( 2000, 1024, true, 1024, 40 );
+    REQUIRE( d.nIntentDBV == 2000 );
+    REQUIRE( d.bUnpin );
+    REQUIRE_FALSE( d.bWriteIntent );
+
+    d = SoftwareDimDecide( 1023, 1024, true, 1024, 40 );
+    REQUIRE( d.nIntentDBV == 40 );
+    REQUIRE( d.bWantPin );
+
+    d = SoftwareDimDecide( 200, 1024, false, 0, 0 );
+    REQUIRE( d.nIntentDBV == 200 );
+    REQUIRE( d.bWantPin );
+
+    d = SoftwareDimDecide( 200, 1024, true, 1024, 500 );
+    REQUIRE( d.nIntentDBV == 200 );
+    REQUIRE( d.bWantPin );
+}
+
+TEST_CASE("Failed re-pin on a floor change preserves intent across polls", "[color]")
+{
+    auto d1 = SoftwareDimDecide( 1023, 2048, true, 1024, 40 );
+    REQUIRE( d1.nIntentDBV == 40 );
+    REQUIRE( d1.bWantPin );
+
+    auto d2 = SoftwareDimDecide( 1023, 2048, true, 1024, d1.nIntentDBV );
+    REQUIRE( d2.nIntentDBV == 40 );
+    REQUIRE( d2.bWantPin );
+
+    auto d3 = SoftwareDimDecide( 1023, 512, true, 1024, 40 );
+    REQUIRE( d3.nIntentDBV == 40 );
+    auto d4 = SoftwareDimDecide( 1023, 512, true, 1024, d3.nIntentDBV );
+    REQUIRE( d4.nIntentDBV == 40 );
+}
+
+TEST_CASE("Old pin state survives failure only while its echo is visible", "[color]")
+{
+    REQUIRE( SoftwareDimOldPinEcho( true, 1023, 1024 ) );
+
+    REQUIRE_FALSE( SoftwareDimOldPinEcho( true, 200, 1024 ) );
+    REQUIRE_FALSE( SoftwareDimOldPinEcho( true, 2047, 1024 ) );
+    REQUIRE_FALSE( SoftwareDimOldPinEcho( false, 1023, 1024 ) );
+
+    auto d = SoftwareDimDecide( 200, 1024, false, 0, 200 );
+    REQUIRE( d.nIntentDBV == 200 );
+    REQUIRE( d.bWantPin );
+}
